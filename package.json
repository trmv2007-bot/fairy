{
  "name": "fairy",
  "version": "0.4.0",
  "description": "Fairy - proactive Windows desktop assistant",
  "private": true,
  "main": "dist/desktop/main.js",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "build": "tsc && vite build",
    "build:main": "tsc",
    "build:ui": "vite build",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:security",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "doctor": "npm run build && electron . --doctor",
    "test:native": "dotnet run --project native/Fairy.Tests/Fairy.Tests.csproj",
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron .",
    "dev:ui": "vite"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
