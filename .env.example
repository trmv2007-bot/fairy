# Fairy provider seeding (optional). Copy to .env and fill in what you have.
# NEVER commit .env — it is gitignored; keys entered here live in the session vault only.
#
# Load into your shell before `npm run dev`, or use your dotenv loader of choice.

# Dev UI: point Electron at the Vite dev server instead of the built bundle.
# FAIRY_DEV_URL=http://localhost:5173

# First-run provider seeding (all four FAIRY_SEED_PROVIDER_* vars are required together;
# seeding is skipped if any is missing or the provider id already exists).
# The API key is vaulted in memory for the session — it is never written to disk.
# FAIRY_SEED_PROVIDER_ENDPOINT_ID=openai
# FAIRY_SEED_PROVIDER_BASE_URL=https://api.openai.com/v1
# FAIRY_SEED_PROVIDER_API_KEY=sk-your-key-here
# FAIRY_SEED_PROVIDER_INCLUDED_COST=true
# FAIRY_SEED_PROVIDER_MODEL=gpt-4o-mini

# Cloud-only mode (user directive): local models are disabled; ProviderRegistry
# throws on any attempt to enable one. There is no env var to override this.
